# Xcode
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# NOTE: nothing generated is ignored (#3078). Generated code is code — the
# model types and the function invokers are all committed,
# reviewed and tested like any other source, and every build path regenerates
# them into the working tree, so a schema change shows up as a diff you commit
# with the change. `primitive.json` below is the exception that proves the
# rule: it is a per-environment build product, not generated code.

# macOS
.DS_Store

# IDE
*.xcuserstate

# Auth credentials
.credentials.json
credentials.json

# Generated by scripts/resolve-primitive-config.sh from the selected Primitive
# environment. The app ID and server URL are typed once, in
# primitive/config.json — never here.
primitive.json

# Primitive CLI local state. One rule, no exception: `.primitive/` is
# machine-local, `primitive/` is the committed configuration tree.
.primitive/

# A child app's own config var values, beside the tree's vars.toml
# (primitive/<env>/vars.<child>.override.toml). Machine-local, never committed.
primitive/*/*.override.toml

# Fastlane / App Store Connect — never commit credentials
fastlane/.env
fastlane/api_key.p8
fastlane/report.xml
fastlane/test_output/
fastlane/README.md
