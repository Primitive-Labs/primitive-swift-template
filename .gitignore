# Xcode
xcuserdata/
DerivedData/
build/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Codegen output — `swift-bao-codegen` regenerates these from
# `models.toml` via the SPM plugin and via `run-ios.sh`. Ignore the
# emitted .swift files but track the directory itself (via its README)
# so a fresh clone has the path Package.swift's `exclude:` references.
Sources/PrimitiveAppTemplate/Models/Generated/*.swift

# macOS
.DS_Store

# IDE
*.xcuserstate

# Auth credentials
.credentials.json
credentials.json

# Generated by scripts/resolve-primitive-config.sh from the selected Primitive
# environment. The app ID and server URL are typed once, in
# .primitive/config.json — never here.
primitive.json

# Primitive CLI local state (.primitive/config.json IS committed; these are per-machine)
.primitive/credentials.json
.primitive/local.json
.primitive/sync-backups/
.primitive/sync/**/.snapshots/

# Fastlane / App Store Connect — never commit credentials
fastlane/.env
fastlane/api_key.p8
fastlane/report.xml
fastlane/test_output/
fastlane/README.md
